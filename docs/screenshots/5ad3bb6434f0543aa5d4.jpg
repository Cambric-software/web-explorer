  <text x="75" y="322" fill="#38bdf8" font-family="monospace" font-size="12" font-weight="bold" letter-spacing="1">HUMOR · RETRO</text>
  <text x="60" y="420" fill="rgba(255,255,255,0.3)" font-family="monospace" font-size="12">WEB EXPLORER VERIFIED ARCHIVE</text>
